# Copy to .env and fill in. Never commit the real .env.
PORT=3001
# Comma-separated allowed frontend origins. `*` matches letters, digits and dashes,
# e.g. https://lingoquest-*-myteam.vercel.app for our own Vercel preview URLs.
CORS_ORIGINS=http://localhost:5173
OPENAI_API_KEY=
# Neon > Connect. Pooled string (host contains -pooler) for the app:
DATABASE_URL=
# Direct string (no -pooler) for `npm run db:migrate`:
DATABASE_URL_UNPOOLED=
