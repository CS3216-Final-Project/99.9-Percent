# Copy to .env and fill in. Never commit the real .env.
PORT=3001
# Comma-separated allowed frontend origins. `*` matches letters, digits and dashes,
# e.g. https://frontend-*-hoo-di-hengs-projects.vercel.app for our own Vercel preview URLs.
CORS_ORIGINS=http://localhost:5173
# Production Vercel value (include the existing project's preview pattern):
# CORS_ORIGINS=https://99-99-percent-web.vercel.app,https://frontend-*-hoo-di-hengs-projects.vercel.app
OPENAI_API_KEY=
# Neon > Connect. Pooled string (host contains -pooler) for the app:
DATABASE_URL=
# Direct string (no -pooler) for `npm run db:migrate`:
DATABASE_URL_UNPOOLED=
