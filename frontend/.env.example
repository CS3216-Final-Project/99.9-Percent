# Copy to .env.local. Only VITE_* variables reach the browser; never put secrets here.
VITE_API_URL=http://localhost:3001
# Production Vercel value: https://99-99-percent-backend.vercel.app

# Server-only Vercel frontend function setting (not VITE_*).
# Set this to the verified HTTPS backend origin for this deployment.
# Local development uses Vite's /api -> localhost:3001 proxy instead.
API_PROXY_TARGET=

# Optional product analytics: configure these in Vercel's Production environment only.
# The project token is a PUBLIC ingestion token, never a personal API key.
# Development, tests and Vercel preview builds do not initialise PostHog.
VITE_ANALYTICS_ENABLED=false
VITE_POSTHOG_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# EU project: https://eu.i.posthog.com
# Optional release label; otherwise the Vercel commit SHA is used.
VITE_BUILD_ID=
